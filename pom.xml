<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.astraNotes</groupId>
    <artifactId>astraNotes</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>AstraNotes</name>
    <description>Secure offline-first markdown note-taking application</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- SQLite JDBC -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.44.0.0</version>
        </dependency>

        <!-- Bouncy Castle for encryption -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk15on</artifactId>
            <version>1.70</version>
        </dependency>

        <!-- JSON processing -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.10.1</version>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.7</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.4.11</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.astraNotes.ui.AstraNotesApp</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!--
          Optional SQLCipher profile.
          This profile is disabled by default. To enable, pass -DuseSqlCipher=true and provide
          the concrete coordinates for the SQLCipher-enabled JDBC driver, e.g.:

          mvn clean package -Psqlcipher -DuseSqlCipher=true \
            -Dsqlcipher.groupId=com.example -Dsqlcipher.artifactId=sqlite-jdbc-sqlcipher -Dsqlcipher.version=1.0.0

          Because SQLCipher requires native libraries for each platform, pick a driver build that matches your OS/arch.
        -->
        <profile>
            <id>sqlcipher</id>
            <activation>
                <property>
                    <name>useSqlCipher</name>
                </property>
            </activation>
            <properties>
                <!-- set these via -D on the mvn command line -->
                <sqlcipher.groupId>${sqlcipher.groupId}</sqlcipher.groupId>
                <sqlcipher.artifactId>${sqlcipher.artifactId}</sqlcipher.artifactId>
                <sqlcipher.version>${sqlcipher.version}</sqlcipher.version>
            </properties>
            <dependencies>
                <dependency>
                    <groupId>${sqlcipher.groupId}</groupId>
                    <artifactId>${sqlcipher.artifactId}</artifactId>
                    <version>${sqlcipher.version}</version>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
